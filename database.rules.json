{
  "rules": {
    "index_mesas": {
      ".read": "auth != null",
      "$mesaId": {
        ".write": "auth != null && (!data.exists() || (data.child('mestre').isString() && (data.child('mestre').val().toLowerCase() + '@multiverso.rpg') == auth.token.email))"
      }
    },
    "usuarios": {
      "$nome": {
        ".read": "auth != null && ($nome.toLowerCase() + '@multiverso.rpg') == auth.token.email",
        ".write": "auth != null && ($nome.toLowerCase() + '@multiverso.rpg') == auth.token.email"
      }
    },
    "mesas": {
      "$mesaId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "midia": {
          "$imagem": {
            ".validate": "newData.hasChildren(['autor', 'url', 'ts']) && newData.child('autor').isString() && newData.child('url').isString() && ((newData.child('url').val().matches(/^data:image\\/(png|jpeg|jpg|webp|gif);base64,/) && newData.child('url').val().length <= 300000) || (newData.child('url').val().beginsWith('https://firebasestorage.googleapis.com/') && newData.child('url').val().length <= 1500)) && newData.child('ts').isNumber()"
          }
        },
        "chatsMensagens": {
          "$chatId": {
            "$msg": {
              ".validate": "newData.hasChildren(['autor', 'texto', 'ts']) && newData.child('autor').isString() && newData.child('texto').isString() && newData.child('texto').val().length <= 500 && newData.child('ts').isNumber()"
            }
          }
        },
        "personagens": {
          "$nome": {
            ".validate": "newData.exists() && newData.hasChildren() && $nome.length >= 1 && $nome.length <= 50"
          }
        },
        "feed_combate": {
          "$entry": {
            ".validate": "newData.hasChildren() && newData.child('tipo').exists() && newData.child('nome').exists()"
          }
        }
      }
    },
    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
